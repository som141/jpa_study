<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="start" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- 엔티티 자동 스캔이 안되므로 명시 등록 (필요한 엔티티 추가) -->
        <class>start.Member</class>
        <class>start.JpaMain</class>

        <properties>
            <!-- JDBC -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/jstudy?useSSL=false&amp;characterEncoding=utf8&amp;serverTimezone=Asia/Seoul"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="123qazasd!"/>

            <!-- Hibernate 옵션 -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
<!--            <property name="hibernate.show_sql" value="true"/>-->
<!--            <property name="hibernate.format_sql" value="true"/>-->
<!--            <property name="hibernate.highlight_sql" value="true"/>-->
            <property name="hibernate.jdbc.time_zone" value="Asia/Seoul"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>



            <!-- 배치/성능 옵션 (원하면 켜기)
            <property name="hibernate.jdbc.batch_size" value="50"/>
            <property name="hibernate.order_inserts" value="true"/>
            <property name="hibernate.order_updates" value="true"/>
            -->
        </properties>
    </persistence-unit>
</persistence>